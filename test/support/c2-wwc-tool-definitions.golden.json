          "minLength": 1,
          "maxLength": 200
        },
        "workflowOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "lineageOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
