          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": "With view definitions: exact step or workflow IDs to return completely."
        },
        "includeSources": {
          "type": "boolean",
          "description": "With view definitions: also return raw definition source files, for diagnosing invalid or incomplete definitions."
        },
        "record": {
          "type": "object",
          "description": "With view check: the exact compact workflow-proposal record to validate."
        }
      }
