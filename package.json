{
  "name": "t3-supervisor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "t3-supervisor": "dist/cli.js"
  },
  "scripts": {
    "autofix": "eslint src test ui/src scripts vite.config.ts vitest.config.ts vitest.harness.config.ts vitest.cpu-bound.config.ts --fix",
    "lint": "eslint src test ui/src scripts vite.config.ts vitest.config.ts vitest.harness.config.ts vitest.cpu-bound.config.ts",
    "typecheck": "tsc --noEmit && tsc -p ui/tsconfig.json",
    "build": "tsc -p tsconfig.build.json && vite build",
    "test": "node --import tsx scripts/run-tests.ts && node --import tsx scripts/run-tests.ts --config vitest.cpu-bound.config.ts",
    "test:harness": "node --import tsx scripts/run-tests.ts --config vitest.harness.config.ts",
    "start": "node dist/main.js",
    "dev:ui": "vite build --watch",
    "test:suites": "node --import tsx scripts/run-tests.ts",
    "test:cpu-bound": "node --import tsx scripts/run-tests.ts --config vitest.cpu-bound.config.ts"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.6",
    "@effect/platform-node": "4.0.6",
    "@effect/sql-sqlite-node": "4.0.6",
    "@modelcontextprotocol/sdk": "1.32.1",
    "effect": "4.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "scheduler": "0.27.0",
    "ws": "8.18.3",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.6"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.6",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
