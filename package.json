{
  "name": "@jfet97/t3-supervisor",
  "version": "0.2.0",
  "description": "Dashboard and background service for supervising T3 projects and conversations",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfet97/t3-supervisor.git"
  },
  "files": [
    "dist",
    "ui-dist",
    "skills"
  ],
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "type": "module",
  "bin": {
    "t3-supervisor": "dist/cli.js"
  },
  "scripts": {
    "autofix": "eslint src test ui/src scripts vite.config.ts vitest.config.ts vitest.harness.config.ts --fix",
    "lint": "eslint src test ui/src scripts vite.config.ts vitest.config.ts vitest.harness.config.ts",
    "typecheck": "tsc --noEmit && tsc -p ui/tsconfig.json",
    "build": "tsc -p tsconfig.build.json && vite build",
    "prepack": "pnpm build",
    "changeset": "changeset",
    "release:version": "changeset version",
    "test": "node --import tsx scripts/run-tests.ts --watchdog-phase=main:vitest.config.ts",
    "test:harness": "node --import tsx scripts/run-tests.ts --config vitest.harness.config.ts",
    "start": "node dist/main.js",
    "dev:ui": "vite build --watch",
    "test:suites": "node --import tsx scripts/run-tests.ts"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.6",
    "@effect/platform-node": "4.0.6",
    "@effect/sql-sqlite-node": "4.0.6",
    "@modelcontextprotocol/sdk": "1.32.1",
    "effect": "4.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "scheduler": "0.27.0",
    "ws": "8.22.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@effect/vitest": "4.0.6",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
